# Settings → Developers → API Keys (admin only). Stays server-side.
TEXTQL_API_KEY=your-key-here

# The app to render, from its URL in TextQL: /app/<id>
TEXTQL_APP_ID=your-app-id

# On-prem only. The plain host — the SDK appends /rpc/public itself.
# TEXTQL_SERVER_URL=https://your-host.example.com

# PORT=4180
