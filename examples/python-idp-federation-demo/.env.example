# IDP_ISSUER is the authorization server whose access tokens get exchanged; it
# must match the TextQL provider's issuer URL. In Okta, use a custom server such
# as https://<you>.okta.com/oauth2/default, not the org server.
#
# The OIDC app this tool signs users in with, at the same identity provider
# TextQL trusts (Okta, Entra ID, ...): a web app with the authorization code and
# refresh token grants and redirect URI http://localhost:5175/callback. It must
# not be the app TextQL itself signs in with.
# Shown on the sign-in button.
IDP_NAME=
IDP_ISSUER=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
# Optional; drop offline_access if the app has no refresh token grant.
# IDP_SCOPES=openid profile email offline_access

# The TextQL deployment and org that trust that provider for token exchange.
TEXTQL_SERVER_URL=https://app.textql.com
TEXTQL_ORG_ID=
