# Required — your TextQL API key
TEXTQL_API_KEY=
# Optional — on-prem / dev host. Omit for the default (https://app.textql.com)
TEXTQL_SERVER_URL=
# Optional — pin new chats to specific connector IDs, comma-separated.
# Unset, the API asks the org and uses its first connector.
TEXTQL_CONNECTOR_IDS=
# Optional — root logger level. Default: INFO
LOG_LEVEL=
# Optional — comma-separated CORS origins.
# Default: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=
# Optional — preview-proxy asset hosts, read by the backend and the browser.
# VITE_ marks a variable public: Vite exposes only those, which is what keeps
# TEXTQL_API_KEY above out of the bundle. Defaults to TextQL SaaS
# (textqlusercontent.com / app.textql.com); set both for a VPC deployment.
VITE_USERCONTENT_HOST=
VITE_APP_HOST=
